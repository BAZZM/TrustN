# Copy to .env and adjust. Never commit .env (contains secrets).
#
# Docker Compose (repo root: docker compose up -d database) maps Postgres to host port 5433:
DATABASE_URL=postgresql://trustnetwork:changeme123@127.0.0.1:5433/trustnetwork
# Use the same password as POSTGRES_PASSWORD in .env at repo root, or the default "changeme123".
#
# Native PostgreSQL on default port:
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASENAME

PORT=5000
JWT_SECRET=dev-secret-change-in-production

# Optional: comma-separated extra allowed CORS origins (e.g. Fly.io web app + preview URLs)
# CORS_ORIGINS=https://trustn-web.fly.dev,https://preview.example.com
